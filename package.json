{
  "name": "crypto-pulse-api",
  "version": "0.10.3",
  "description": "x402 paid crypto market pulse for AI agents: one call replaces four (spots, Fear & Greed, funding, DeFi) + summary; free sample + MCP",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "generate-wallets": "node scripts/generate-wallets.js",
    "fund-devnet": "node scripts/fund-devnet.js",
    "ensure-atas": "node scripts/ensure-atas.js",
    "buy": "node scripts/buy-pulse.js",
    "smoke": "NETWORK=devnet node scripts/smoke.js",
    "start:mainnet": "NETWORK=mainnet node src/server.js",
    "check:mainnet-402": "node scripts/check-mainnet-402.js",
    "mcp:stdio": "node mcp/stdio.js",
    "test:mcp": "node scripts/test-mcp.js",
    "test:summary": "node scripts/test-summary.js",
    "arena:submit": "node scripts/arena-submit.js",
    "test:autopay": "node scripts/test-autopay.js",
    "test:arena": "node scripts/test-arena.js",
    "test:house": "node scripts/test-house-and-free.js",
    "test:pulse-elig": "node scripts/test-pulse-eligibility.js",
    "test:referrals": "node scripts/test-referrals.js",
    "test:arena-assets": "node scripts/test-arena-assets.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@scure/base": "^2.4.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.6.0",
    "@solana/web3.js": "^3.1.1",
    "@x402/core": "^2.29.0",
    "@x402/express": "^2.29.0",
    "@x402/extensions": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "@x402/svm": "^2.29.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnight232/crypto-pulse-api.git"
  },
  "homepage": "https://cryptopulseapi.com",
  "bugs": {
    "url": "https://github.com/midnight232/crypto-pulse-api/issues"
  },
  "keywords": [
    "x402",
    "solana",
    "mcp",
    "crypto",
    "ai-agents",
    "usdc",
    "market-data",
    "fear-greed",
    "hyperliquid",
    "defillama"
  ]
