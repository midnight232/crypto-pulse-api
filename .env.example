# NETWORK=devnet|mainnet
NETWORK=devnet
HOST=0.0.0.0
PORT=4021
PRICE=$0.02
SPOTS_PRICE=$0.005

# Facilitator selection:
# - leave unset for defaults (x402.org on devnet, PayAI on mainnet — no API key)
# - FACILITATOR=cdp to settle via Coinbase CDP (needed for CDP Bazaar indexing)
# FACILITATOR=cdp
# FACILITATOR_URL=https://facilitator.payai.network
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required when FACILITATOR=cdp (view-only CDP Secret API key; never commit):
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Mainnet receive wallet (public). Default is Matt's approved address.
# MAINNET_PAY_TO=37CP6YemJJQ6sMu4Ue6C7pgC7BXkN6iCcCHVeZunvPod

# Devnet seller override (else .devnet-keys/seller.env)
# SELLER_ADDRESS=

# Optional RPC
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public base URL for discovery docs
# PUBLIC_BASE_URL=https://cryptopulseapi.com

# Rate limit
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Crypto Pulse Prediction Arena (free entry; manual sponsor prizes)
# ARENA_PRIZE_POOL=          # empty → "Prize pool: to be announced by the sponsor"
# ARENA_ADMIN_TOKEN=         # protects /v1/arena/admin/* export + cleanup (keep secret)
# ARENA_DATA_PATH=data/arena.json
# ARENA_RATE_LIMIT_MAX=30
